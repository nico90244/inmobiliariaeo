{
  "rewrites": [
    { "source": "/((?!assets|api|favicon.ico|robots.txt|sitemap.xml|hero-bg.jpg|emergencia-hero.mp4).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
